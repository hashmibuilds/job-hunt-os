<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Job Hunt OS — Hashmi</title><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><style>
:root{--bg:#090b10;--panel:#11151d;--panel2:#171c25;--text:#f4f6fa;--muted:#97a0ae;--line:#252c38;--accent:#8b7cff;--green:#49d17d;--yellow:#f2c94c;--red:#ff6b6b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px Inter,system-ui,-apple-system,Segoe UI,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}.app{display:flex;min-height:100vh}.side{width:240px;border-right:1px solid var(--line);padding:22px 14px;position:sticky;top:0;height:100vh}.brand{font-weight:850;font-size:20px;padding:0 10px 8px}.brand span{color:var(--accent)}.sub{padding:0 10px 20px;color:var(--muted);font-size:11px}.nav button{display:block;width:100%;text-align:left;background:none;border:0;color:var(--muted);padding:11px 12px;border-radius:9px;margin:3px 0}.nav button.active,.nav button:hover{background:var(--panel2);color:var(--text)}.main{flex:1;padding:28px;max-width:1450px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.eyebrow{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.12em}.title{font-size:30px;font-weight:800;margin-top:5px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px}.metric{font-size:28px;font-weight:800;margin-top:8px}.muted{color:var(--muted)}.section{margin-top:20px}.section h2{font-size:16px;margin:0 0 12px}.jobs{display:grid;gap:10px}.job{display:flex;justify-content:space-between;gap:18px;align-items:center}.job-main{min-width:0}.job-title{font-weight:750;font-size:15px}.tag{display:inline-block;border:1px solid var(--line);background:var(--panel2);color:var(--muted);border-radius:999px;padding:4px 8px;font-size:11px;margin:6px 4px 0 0}.score{font-size:20px;font-weight:800;white-space:nowrap}.score.good{color:var(--green)}.score.mid{color:var(--yellow)}.score.bad{color:var(--red)}.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:9px;padding:9px 12px}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.danger{border-color:#5b2727;color:#ff9b9b}.btn + .btn{margin-left:7px}.row{display:flex;gap:10px;align-items:center}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:11px;border-bottom:1px solid var(--line);text-align:left}.table th{color:var(--muted);font-weight:600;font-size:12px}.pill{font-size:11px;border-radius:999px;padding:4px 8px;background:var(--panel2);color:var(--muted)}.empty{padding:35px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}.form{display:grid;gap:10px}.form input,.form textarea,.form select{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:10px}.form textarea{min-height:120px;resize:vertical}.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.authbox{width:min(430px,100%);background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:25px}.status{font-size:12px;color:var(--muted);margin-top:8px}.chat{position:fixed;right:22px;bottom:22px;width:340px;background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:0 20px 60px #0008;display:none;overflow:hidden}.chat.open{display:block}.chat-head{padding:13px 15px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.chat-body{height:260px;overflow:auto;padding:12px}.bubble{padding:9px 11px;border-radius:10px;background:var(--panel2);margin-bottom:8px;line-height:1.45}.bubble.user{background:#242039;margin-left:35px}.chat-input{display:flex;border-top:1px solid var(--line)}.chat-input input{flex:1;background:none;border:0;color:var(--text);padding:12px}.chat-input button{background:none;border:0;color:var(--accent);padding:12px}.toast{position:fixed;left:50%;bottom:25px;transform:translateX(-50%);background:#202633;border:1px solid var(--line);padding:10px 14px;border-radius:9px;display:none;z-index:20}.small{font-size:12px}.accent{color:var(--accent)}.badge{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border:1px solid var(--line);border-radius:999px;font-size:11px}.dot{width:7px;height:7px;border-radius:50%;background:var(--green)}@media(max-width:900px){.side{width:190px}.grid{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.main{padding:18px}}@media(max-width:650px){.side{display:none}.grid{grid-template-columns:1fr 1fr}.main{padding:14px}.chat{left:12px;right:12px;width:auto}}
</style></head><body>
<div id="auth" class="auth"><div class="authbox"><div class="brand">JOB HUNT <span>OS</span></div><p class="muted">Hashmi's private career command center.</p><div class="form"><input id="email" type="email" placeholder="Email"><input id="password" type="password" placeholder="Password"><button class="btn primary" onclick="signIn()">Sign in</button><button class="btn" onclick="signUp()">Create account</button></div><div id="authStatus" class="status"></div></div></div>
<div id="shell" class="app hidden"><aside class="side"><div class="brand">JOB HUNT <span>OS</span></div><div class="sub">LIVE • SUPABASE CONNECTED</div><div class="nav" id="nav"></div><div style="position:absolute;bottom:20px;padding:0 10px;color:#697384;font-size:12px"><span class="badge"><span class="dot"></span><span id="userBadge">Signed in</span></span><br><button class="btn" style="margin-top:9px" onclick="signOut()">Sign out</button></div></aside><main class="main"><div class="top"><div><div class="eyebrow">Career Command Center</div><div class="title" id="pageTitle">Overview</div></div><button class="btn" onclick="openChat()">Ask Zaffar</button></div><div id="content"></div></main></div>
<div class="chat" id="chat"><div class="chat-head"><b>ZAFFAR</b><button class="btn" onclick="openChat()">×</button></div><div class="chat-body" id="chatBody"><div class="bubble">I’m connected to your Job Hunt OS data. Ask me which opportunity to prioritize, what to work on, or where the pipeline is blocked.</div></div><div class="chat-input"><input id="chatInput" placeholder="Ask about your job hunt…" onkeydown="if(event.key==='Enter')askZaffar()"><button onclick="askZaffar()">Send</button></div></div><div class="toast" id="toast"></div>
<script>
const SB_URL='https://xhexbwwuykzffiakcmto.supabase.co';const SB_KEY='sb_publishable_fjAC3DS94qkSGF9942dgFg_t0jWbefC';const client=supabase.createClient(SB_URL,SB_KEY);let user=null,schema={},data={profiles:[],jobs:[],apps:[],interviews:[],skills:[],resumes:[],companies:[],scores:[],emails:[],followups:[]};
const pages={overview:'Overview',career:'Career Intelligence',jobs:'Job Discovery',applications:'Applications',interviews:'Interviews',research:'Research',skills:'Skills & Gaps',profile:'Profile'};let page='overview';
function toast(x){let t=document.getElementById('toast');t.textContent=x;t.style.display='block';setTimeout(()=>t.style.display='none',2200)}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function val(row,keys,def=''){for(const k of keys)if(row&&row[k]!==undefined&&row[k]!==null&&row[k]!=='')return row[k];return def}
async function loadSchema(){try{let r=await fetch(SB_URL+'/rest/v1/',{headers:{apikey:SB_KEY,Authorization:'Bearer '+(await client.auth.getSession()).data.session?.access_token||SB_KEY}});if(r.ok)schema=await r.json()}catch(e){} }
function cols(table){let d=schema.definitions?.[table];return d?.properties?Object.keys(d.properties):[]}
function pick(table,candidates,value){let cs=cols(table);let k=candidates.find(x=>cs.includes(x));return k?{[k]:value}:{} }
async function select(table){const {data:d,error}=await client.from(table).select('*');if(error){console.error(table,error);return []}return d||[]}
async function insert(table,obj){let clean={};for(const [k,v] of Object.entries(obj)){if(cols(table).includes(k)&&v!==undefined&&v!=='')clean[k]=v}if('user_id' in Object.fromEntries(cols(table).map(x=>[x,true])))clean.user_id=user.id;const {data:d,error}=await client.from(table).insert(clean).select().single();if(error){toast(error.message);return null}return d}
async function update(table,id,obj){let clean={};for(const [k,v] of Object.entries(obj))if(cols(table).includes(k)&&v!==undefined)clean[k]=v;const {error}=await client.from(table).update(clean).eq('id',id);if(error){toast(error.message);return false}return true}
async function boot(){let s=await client.auth.getSession();user=s.data.session?.user;if(user){await showApp()};client.auth.onAuthStateChange(async(_e,session)=>{user=session?.user||null;if(user)await showApp();else document.getElementById('shell').classList.add('hidden')})}
async function signIn(){let e=email.value.trim(),p=password.value;authStatus.textContent='Signing in…';let {error}=await client.auth.signInWithPassword({email:e,password:p});authStatus.textContent=error?error.message:''}
async function signUp(){let e=email.value.trim(),p=password.value;if(p.length<6){authStatus.textContent='Password must be at least 6 characters.';return}authStatus.textContent='Creating account…';let {error}=await client.auth.signUp({email:e,password:p});authStatus.textContent=error?error.message:'Account created. Check your email if confirmation is enabled.'}
async function signOut(){await client.auth.signOut()}
async function showApp(){document.getElementById('auth').classList.add('hidden');document.getElementById('shell').classList.remove('hidden');userBadge.textContent=user.email||'Signed in';await loadSchema();await loadData();renderNav();render()}
async function loadData(){let map={profiles:'jh_profiles',jobs:'jh_jobs',apps:'jh_applications',interviews:'jh_interviews',research:'jh_company_research',skills:'jh_skills',resumes:'jh_resume_versions',companies:'jh_companies',scores:'jh_job_scores',emails:'jh_emails',followups:'jh_follow_ups'};for(const [k,t] of Object.entries(map))data[k]=await select(t);const cm=new Map(data.companies.map(c=>[c.id,c.name]));const sm=new Map(data.scores.map(x=>[x.job_id,x]));data.jobs=data.jobs.map(j=>({...j,company_name:cm.get(j.company_id)||'Unknown company',score_record:sm.get(j.id)||null}))}
function renderNav(){nav.innerHTML=Object.entries(pages).map(([k,v])=>`<button class="${page===k?'active':''}" onclick="go('${k}')">${v}</button>`).join('')}
async function go(p){page=p;pageTitle.textContent=pages[p];renderNav();render()}
function scoreClass(n){return n>=80?'good':n>=60?'mid':'bad'}
function getProfile(){return data.profiles[0]||{}}
function jobScore(j){let x=j?.score_record;if(x)return {fit:Number(x.match_score||0),tr:Number(x.career_value_score||0),opp:Number(x.opportunity_score||0)};return {fit:0,tr:0,opp:0}}
function overview(){let due=data.followups.filter(f=>f.status==='Pending'&&new Date(f.due_at)<=new Date()).length;let awaiting=data.emails.filter(e=>e.approval_status==='Awaiting Approval').length;let sent=data.emails.filter(e=>e.send_status==='Sent').length;let scored=data.jobs.filter(j=>j.score_record).length;let top=data.jobs.slice().sort((a,b)=>jobScore(b).opp-jobScore(a).opp)[0];return `<div class="grid"><div class="card"><div class="muted">Jobs discovered</div><div class="metric">${data.jobs.length}</div></div><div class="card"><div class="muted">Applications</div><div class="metric">${data.apps.length}</div></div><div class="card"><div class="muted">Interviews</div><div class="metric">${data.interviews.length}</div></div><div class="card"><div class="muted">Follow-ups due</div><div class="metric">${due}</div></div></div><div class="grid section"><div class="card"><div class="muted">Jobs scored</div><div class="metric">${scored}</div></div><div class="card"><div class="muted">Awaiting approval</div><div class="metric">${awaiting}</div></div><div class="card"><div class="muted">Emails sent</div><div class="metric">${sent}</div></div><div class="card"><div class="muted">Response rate</div><div class="metric">${data.apps.length?Math.round(data.interviews.length/data.apps.length*100):0}%</div></div></div><div class="two section"><div class="card"><h2>Priority opportunity</h2>${top?`<div class="job-title">${esc(top.title)}</div><div class="muted">${esc(top.company_name||'Unknown company')}</div><div class="score ${jobScore(top).opp>=75?'good':jobScore(top).opp>=55?'mid':'bad'}" style="margin-top:10px">${jobScore(top).opp}/100</div><div class="muted small" style="margin-top:8px">Optimize for probability × career value, not application count.</div>`:'<div class="muted">Score some jobs to identify the highest-value opportunity.</div>'}</div><div class="card"><h2>Follow-up engine</h2><div class="muted">Due drafts are created only after their scheduled date. Nothing is sent automatically.</div><button class="btn primary" style="margin-top:12px" onclick="processDueFollowUps()">Process due follow-ups</button></div></div>`}
function jobs(){return `<div class="row" style="justify-content:space-between;margin-bottom:12px"><div class="muted">Discovery → dedupe → Supabase ingestion is now live.</div><div><button class="btn primary" onclick="discoverJobs()">⚡ Discover jobs</button><button class="btn" onclick="addJob()">+ Add job</button></div></div><div id="discoveryStatus" class="status" style="margin-bottom:12px"></div><div class="jobs">${data.jobs.length?data.jobs.map(jobCard).join(''):'<div class="empty">No jobs in the database yet. Run discovery to find opportunities.</div>'}</div>`}
function domainCompany(url){try{let h=new URL(url).hostname.replace(/^www\./,'');let parts=h.split('.');return parts.length>=2?parts[parts.length-2].replace(/[-_]+/g,' '):h}catch(e){return 'Unknown Company'}}
async function discoverJobs(){let query=prompt('What roles should I search for?','finance analyst entry level Excel financial analysis');if(!query)return;let location=prompt('Location?','Mumbai, India');if(location===null)return;let limit=Math.min(Math.max(parseInt(prompt('How many results?','10')||'10',10),1),25);let st=document.getElementById('discoveryStatus');if(st)st.textContent='Searching public web sources…';try{let {data:r,error}=await client.functions.invoke('job-discovery-v2',{body:{query,location,limit}});if(error)throw error;let results=Array.isArray(r?.results)?r.results:[];if(!results.length){if(st)st.textContent='No discovery results returned.';toast('No jobs found');return}let saved=0,dupes=0;for(const x of results){let url=x.url||x.href||x.link||null;if(!url)continue;let title=x.title||x.name||x.text||'Untitled role';let description=x.description||x.snippet||x.text||null;let company=x.company||x.company_name||domainCompany(url);let {data:id,error:e}=await client.rpc('jh_ingest_job',{p_title:title,p_url:url,p_description:description,p_company_name:company,p_location:location,p_source_name:'public web search',p_source_type:'search',p_source_base_url:null,p_external_id:x.external_id||null});if(e){console.warn('ingest failed',e);continue}if(id)saved++}await loadData();render();if(st)st.textContent=`Discovery returned ${results.length} results • ${saved} persisted/upserted • duplicates safely collapsed.`;toast(`${saved} jobs ingested`)}catch(e){console.error(e);if(st)st.textContent='Discovery failed: '+(e.message||'unknown error');toast('Discovery failed')}}
function applications(){let jobFor=a=>data.jobs.find(j=>j.id===a.job_id)||{};let fuFor=a=>data.followups.filter(f=>f.application_id===a.id).sort((x,y)=>new Date(y.created_at)-new Date(x.created_at))[0];return `<div class="row" style="justify-content:space-between;margin-bottom:12px"><div class="muted">Approval-first: drafts never send automatically.</div><div><button class="btn" onclick="processDueFollowUps()">Process due</button> <button class="btn primary" onclick="addApplication()">+ Create application</button></div></div>${data.apps.length?`<table class="table"><tr><th>Role</th><th>Company</th><th>Status</th><th>Resume</th><th>Follow-up</th><th>Action</th></tr>${data.apps.map(a=>{let j=jobFor(a),em=data.emails.filter(e=>e.application_id===a.id).sort((x,y)=>new Date(y.created_at)-new Date(x.created_at))[0],fu=fuFor(a);return `<tr><td>${esc(j.title||'—')}</td><td>${esc(j.company_name||'—')}</td><td><span class="pill">${esc(val(a,['status'],'—'))}</span></td><td>${esc((data.resumes.find(r=>r.id===a.resume_id)||{}).name||'—')}</td><td>${fu?`${esc(fu.status)}<br><span class="small muted">${esc(new Date(fu.due_at).toLocaleDateString())}</span>`:'—'}</td><td>${!em?`<button class="btn primary" onclick="draftApplicationEmail('${a.id}')">Draft Email</button>`:''} ${em?.approval_status==='Awaiting Approval'?`<button class="btn" onclick="editEmail('${em.id}')">Edit</button> <button class="btn" onclick="approveEmail('${em.id}')">Approve</button>`:''} ${em?.approval_status==='Approved'&&em?.send_status!=='Sent'?`<button class="btn primary" onclick="sendApplicationEmail('${em.id}')">Send</button>`:''} <button class="btn" onclick="scheduleFollowUp('${a.id}')">Follow-up</button> <button class="btn" onclick="advanceApp('${a.id}')">Advance</button></td></tr>`}).join('')}</table>`:'<div class="empty">No applications yet. Shortlist a job first.</div>'}<div class="section card"><h2>Application Emails</h2>${data.emails.length?`<table class="table"><tr><th>Type</th><th>Recipient</th><th>Approval</th><th>Send</th></tr>${data.emails.map(e=>`<tr><td>${esc(e.email_type)}</td><td>${esc(e.recipient_email||'Not set')}</td><td><span class="pill">${esc(e.approval_status)}</span></td><td><span class="pill">${esc(e.send_status)}</span></td></tr>`).join('')}</table>`:'<div class="muted">No email drafts yet.</div>'}</div>`}
function interviews(){let appFor=i=>data.apps.find(a=>a.id===i.application_id)||{};return `<div class="row" style="justify-content:space-between;margin-bottom:12px"><div class="muted">Prep is grounded in the linked JD, your stored profile/resume, and the interview stage. No invented experience.</div><button class="btn primary" onclick="addInterview()">+ Add interview</button></div>${data.interviews.length?`<table class="table"><tr><th>Company</th><th>Role</th><th>Stage</th><th>Date</th><th>Interviewer</th><th>Action</th></tr>${data.interviews.map(i=>{let a=appFor(i),j=data.jobs.find(x=>x.id===a.job_id)||{};return `<tr><td>${esc(j.company_name||'—')}</td><td>${esc(j.title||'—')}</td><td>${esc(val(i,['stage'],'—'))}</td><td>${esc(i.scheduled_at?new Date(i.scheduled_at).toLocaleString():'—')}</td><td>${esc(i.interviewer||'—')}</td><td><button class="btn" onclick="generateInterviewPrep('${i.id}')">Generate Prep</button> <button class="btn" onclick="openCompanyResearch('${j.id}')">Research</button></td></tr>`}).join('')}</table>`:'<div class="empty">No interviews tracked yet.</div>'}<div id="prepPanel" class="section card"><h2>Interview Prep</h2><div class="muted">Select an interview and generate a prep pack.</div></div>`}
function skills(){return `<div class="card"><h2>One Active Priority</h2><p class="muted">The system is designed to prevent skill overload. Keep one primary skill active and queue the rest.</p>${data.skills.length?`<table class="table"><tr><th>Skill</th><th>Status</th><th>Level</th><th>Evidence</th></tr>${data.skills.map(s=>`<tr><td><b>${esc(val(s,['name','skill'],'—'))}</b></td><td><span class="pill">${esc(val(s,['status'],'QUEUED'))}</span></td><td>${esc(val(s,['level','proficiency'],'—'))}</td><td>${esc(val(s,['evidence'],'—'))}</td></tr>`).join('')}</table>`:'<div class="empty">No skills tracked yet.</div>'}</div>`}
function career(){let p=getProfile();let active=data.skills.find(s=>String(val(s,['status'],'')).toUpperCase()==='ACTIVE')||null;let target=val(p,['target_direction','career_direction'],'Finance / Business / Strategy');let financeRoles=['Finance Operations Analyst','MIS / Reporting Analyst','Junior Financial Analyst','FP&A Analyst'];let gaps=['Advanced Excel + financial analysis evidence','Accounting / financial statement fundamentals','Power BI reporting','SQL for analytics'];return `<div class="grid"><div class="card"><div class="muted">Target direction</div><div class="metric" style="font-size:20px">${esc(target)}</div></div><div class="card"><div class="muted">Transition status</div><div class="metric" style="font-size:20px">Bridge phase</div></div><div class="card"><div class="muted">Active priority</div><div class="metric" style="font-size:20px">${esc(active?val(active,['name','skill'],'Excel'): 'Excel + Financial Analysis')}</div></div><div class="card"><div class="muted">Pipeline</div><div class="metric" style="font-size:20px">${data.apps.length} apps</div></div></div><div class="two section"><div class="card"><h2>Recommended transition roles</h2><p class="muted">These are the bridge roles the OS should prioritize before higher-barrier finance roles.</p>${financeRoles.map((r,i)=>`<div style="padding:10px 0;border-bottom:1px solid var(--line)"><b>${r}</b><div class="small muted">${i===0?'Operations + finance bridge':i===1?'Strong Excel/MIS evidence path':i===2?'Direct finance entry target':'Later-stage target once finance evidence improves'}</div></div>`).join('')}</div><div class="card"><h2>Current gap stack</h2>${gaps.map((g,i)=>`<div style="padding:10px 0;border-bottom:1px solid var(--line)"><span class="pill">${i===0?'ACTIVE':'QUEUED'}</span> <b>${g}</b></div>`).join('')}<p class="small muted" style="margin-top:14px">Market requirement status: baseline only until a fresh web research pass is available. The OS will not invent market percentages.</p></div></div><div class="section card"><div class="row" style="justify-content:space-between"><div><h2>Career digest</h2><div class="muted">Send your current high-priority jobs, applications, follow-ups and interview status to your signed-in email.</div></div><button class="btn primary" onclick="sendCareerDigest()">Email me a digest</button></div><div class="small muted" style="margin-top:10px">Application/recruiter emails remain approval-first. This digest is a personal notification email.</div></div>`}
async function sendCareerDigest(){toast('Preparing career digest…');let {data:r,error}=await client.functions.invoke('job-notification-digest',{body:{}});if(error){toast('Digest failed: '+error.message);return}if(!r?.ok){toast('Digest failed: '+(r?.error||'Unknown error'));return}toast('Career digest sent to '+(r.recipient||user.email))}
function profile(){let p=getProfile();return `<div class="two"><div class="card"><h2>Profile</h2><div class="form"><input id="pn" value="${esc(val(p,['name','full_name'],user.email?.split('@')[0]||''))}" placeholder="Name"><input id="cr" value="${esc(val(p,['current_role','role'],''))}" placeholder="Current role"><input id="ed" value="${esc(val(p,['education','degree'],''))}" placeholder="Education"><input id="cs" type="number" value="${esc(val(p,['current_salary'],25000))}" placeholder="Current monthly salary"><input id="ts" type="number" value="${esc(val(p,['target_salary'],35000))}" placeholder="Target monthly salary"><input id="td" value="${esc(val(p,['target_direction','career_direction'],'Finance / Business / Strategy'))}" placeholder="Target direction"><button class="btn primary" onclick="saveProfile()">Save profile</button></div></div><div class="card"><h2>Connection</h2><p>Authentication is active and data is being read from Supabase.</p><p class="muted">Your public publishable key is safe for browser use. Secret/service-role keys are not used here.</p><p class="small muted">Next production layer: server-side job discovery + AI matching + Resend approval workflow.</p></div></div>`}
function research(){let saved=data.research||[];let rows=data.jobs.slice().sort((a,b)=>jobScore(b).opp-jobScore(a).opp).map(j=>{let r=saved.find(x=>x.job_id===j.id);let host='';try{host=new URL(j.url||'').hostname.replace(/^www\./,'')}catch(e){};return `<tr><td><b>${esc(j.company_name||'—')}</b><br><span class="small muted">${esc(j.title||'')}</span></td><td><span class="score ${scoreClass(jobScore(j).opp)}">${jobScore(j).opp}/100</span></td><td>${r?`<span class="pill">Saved ${esc(new Date(r.researched_at).toLocaleDateString())}</span>`:'<span class="pill">Not researched</span>'}</td><td>${host?`<button class="btn" onclick="openUrl('https://${esc(host)}')">Company</button>`:''} <button class="btn" onclick="searchCompany('${j.id}')">Search</button> <button class="btn" onclick="searchHiring('${j.id}')">Hiring</button> <button class="btn" onclick="saveResearch('${j.id}')">Save notes</button>${j.url?` <button class="btn" onclick="openUrl('${esc(j.url)}')">JD</button>`:''}</td></tr>`}).join('');return `<div class="row" style="justify-content:space-between;margin-bottom:12px"><div class="muted">Research workspace — use live public sources, verify facts, then save findings to the opportunity.</div></div><div class="card"><table class="table"><tr><th>Company / Role</th><th>Opportunity</th><th>Saved research</th><th>Actions</th></tr>${rows||'<tr><td colspan="4" class="muted">Add jobs first.</td></tr>'}</table></div><div class="section card"><h2>Research discipline</h2><div class="muted">Verify company facts, hiring activity, role requirements and source URLs before using them in an application or interview answer.</div></div>`}
function openUrl(url){if(/^https?:\/\//i.test(url))window.open(url,'_blank','noopener')}
function searchCompany(id){let j=data.jobs.find(x=>x.id===id);if(!j)return;let q=encodeURIComponent(`"${j.company_name||''}" company careers official`);window.open('https://www.google.com/search?q='+q,'_blank','noopener');toast('Company research search opened')}
function searchHiring(id){let j=data.jobs.find(x=>x.id===id);if(!j)return;let q=encodeURIComponent(`"${j.company_name||''}" hiring jobs ${j.title||''}`);window.open('https://www.google.com/search?q='+q,'_blank','noopener');toast('Hiring activity search opened')}
async function saveResearch(id){let j=data.jobs.find(x=>x.id===id);if(!j)return;let summary=prompt('Verified company summary (short):','');if(summary===null)return;let signals=prompt('Hiring signals, comma-separated:','');if(signals===null)return;let notes=prompt('Research notes / source URLs:','');if(notes===null)return;let website='';try{website=new URL(j.url||'').origin}catch(e){}let {data:r,error}=await client.rpc('jh_save_company_research',{p_job_id:id,p_company_name:j.company_name||'Unknown company',p_website:website||null,p_careers_url:null,p_source_url:j.url||null,p_summary:summary,p_hiring_signals:signals.split(',').map(x=>x.trim()).filter(Boolean),p_research_text:notes});if(error){toast('Research save failed: '+error.message);return}await loadData();render();toast('Research saved')}
function render(){let c=content;if(page==='overview')c.innerHTML=overview();if(page==='career')c.innerHTML=career();if(page==='jobs')c.innerHTML=jobs();if(page==='applications')c.innerHTML=applications();if(page==='interviews')c.innerHTML=interviews();if(page==='research')c.innerHTML=research();if(page==='skills')c.innerHTML=skills();if(page==='profile')c.innerHTML=profile()}
async function addJob(){let company=prompt('Company?');if(!company)return;let role=prompt('Role?');if(!role)return;let location=prompt('Location?','India');let url=prompt('Job URL?','');let {data:r,error}=await client.rpc('jh_ingest_job',{p_title:role,p_url:url||null,p_description:null,p_company_name:company,p_location:location||null,p_source_name:'Manual'});if(error){toast('Job save failed: '+error.message);return}await loadData();render();toast(r?.job_id?'Job saved to Supabase':'Job processed')}
async function shortlist(id){let j=data.jobs.find(x=>x.id===id);if(!j)return;let ok=await update('jh_jobs',id,{status:'Shortlisted'});if(ok){j.status='Shortlisted';render();toast('Shortlisted')}}
async function addApplication(){let candidates=data.jobs.filter(x=>val(x,['status'])==='Shortlisted');if(!candidates.length)candidates=data.jobs;if(!candidates.length){toast('Add a job first');return}let j=candidates[0];if(candidates.length>1){let choices=candidates.map((x,i)=>`${i+1}. ${x.title||'Role'} — ${x.company_name||'Company'}`).join('\n');let pick=prompt('Which job should this application use?\n\n'+choices,'1');if(pick===null)return;let idx=Number(pick)-1;if(!Number.isInteger(idx)||!candidates[idx]){toast('Invalid job selection');return}j=candidates[idx]}let {data:r,error}=await client.rpc('jh_recommend_resume',{p_job_id:j.id});if(error){toast('Resume selection failed');return}if(!r?.resume_id){toast('Activate a resume first');alert(r?.rationale||'No active resume');return}let a=await insert('jh_applications',{job_id:j.id,company_id:j.company_id,resume_id:r.resume_id,status:'Ready to Apply',application_url:j.url||null});if(a){await loadData();render();toast('Application created → Ready to Apply')}}

function makeApplicationDraft(j,p,r,recipientName){let first=(p?.full_name||p?.name||'').trim();let greeting=recipientName?.trim()?`Hi ${recipientName.trim()},`:'Hello Hiring Team,';let role=val(j,['title','role'],'the role');let company=val(j,['company_name','company'],'your company');let current=val(p,['current_job_title','current_role','role'],'customer operations professional');let direction=val(p,['target_direction','career_direction'],'finance / business');let resumeName=r?.name||'my resume';let subject=`Application — ${role} | ${first||'Mohammad Hashmi'}`;let body=`${greeting}\n\nI’m writing to apply for the ${role} opportunity at ${company}. I currently work in ${current}, where I’ve developed customer operations, communication and process-discipline experience, and I’m intentionally transitioning toward ${direction}.\n\nI believe my existing experience, education and transferable skills can add value in this role. I’ve attached ${resumeName} for consideration.\n\nI’d appreciate the opportunity to discuss how my background could fit the team.\n\nRegards,\n${first||'Mohammad Hashmi'}`;return {subject,body}}

async function draftApplicationEmail(appId){let a=data.apps.find(x=>x.id===appId);if(!a)return;if(data.emails.some(e=>e.application_id===appId&&e.email_type==='application'&&e.send_status!=='Failed')){toast('Application email already exists — edit/approve the existing draft');return;}let j=data.jobs.find(x=>x.id===a.job_id);if(!j){toast('Linked job not found');return}let p=getProfile();let r=data.resumes.find(x=>x.id===a.resume_id)||data.resumes.find(x=>x.is_active)||null;let recipientName=prompt('Recruiter / hiring manager name (optional):','');if(recipientName===null)return;let recipientEmail=prompt('Recruiter email (optional — leave blank if unknown):','');if(recipientEmail===null)return;let d=makeApplicationDraft(j,p,r,recipientName);let show=`SUBJECT: ${d.subject}\n\n${d.body}\n\nApproval: NOT APPROVED / NOT SENT`;if(!confirm(show+'\n\nSave this draft?'))return;let e=await insert('jh_emails',{application_id:a.id,email_type:'application',recipient_email:recipientEmail||null,recipient_name:recipientName||null,subject:d.subject,body:d.body,approval_status:'Awaiting Approval',send_status:'Not Sent'});if(e){let tr=await client.rpc('jh_transition_application',{p_application_id:a.id,p_next_status:'Drafted'});if(tr.error){toast('Draft saved, status transition failed');}await loadData();render();toast('Email draft saved — approval required before sending')}}
async function advanceApp(id){let a=data.apps.find(x=>x.id===id);if(!a)return;let next={Discovered:'Shortlisted',Shortlisted:'Ready to Apply','Ready to Apply':'Drafted',Drafted:'Awaiting Approval','Awaiting Approval':'Applied',Applied:'Recruiter Contacted','Recruiter Contacted':'Follow-up Due','Follow-up Due':'Interview',Interview:'Assessment',Assessment:'Offer',Offer:'Closed',Rejected:'Closed',Withdrawn:'Closed'}[a.status];if(!next){toast('No valid next transition');return}let {data:r,error}=await client.rpc('jh_transition_application',{p_application_id:id,p_next_status:next});if(error){toast(error.message);return}await loadData();render();toast('Application → '+next)}
async function approveEmail(id){let {data:r,error}=await client.rpc('jh_approve_email',{p_email_id:id});if(error){toast(error.message);return}await loadData();render();toast('Email approved — ready to send')}
async function sendApplicationEmail(id){if(!confirm('Send this approved application email now?'))return;toast('Sending via Resend…');let {data:r,error}=await client.functions.invoke('job-application-send',{body:{email_id:id}});if(error){toast('Send failed: '+error.message);return}if(!r?.ok){toast('Send failed: '+(r?.error||'Unknown error'));return}await loadData();render();toast('Email sent successfully')}
async function scheduleFollowUp(id){let days=prompt('Follow up after how many days?','5');if(days===null)return;let {data:r,error}=await client.rpc('jh_schedule_follow_up',{p_application_id:id,p_days:Number(days)});if(error){toast(error.message);return}await loadData();render();toast('Follow-up scheduled for '+new Date(r.due_at).toLocaleString())}
async function editEmail(id){let e=data.emails.find(x=>x.id===id);if(!e)return;let to=prompt('Recipient email:',e.recipient_email||'');if(to===null)return;let subject=prompt('Subject:',e.subject||'');if(subject===null)return;let body=prompt('Body:',e.body||'');if(body===null)return;let ok=await update('jh_emails',id,{recipient_email:to.trim()||null,subject,body});if(ok){await loadData();render();toast('Email draft updated')}}
async function processDueFollowUps(){toast('Processing due follow-ups…');let {data:r,error}=await client.functions.invoke('job-followup-worker',{body:{}});if(error){toast('Worker failed: '+error.message);return}if(!r?.ok){toast('Worker failed: '+(r?.error||'Unknown error'));return}await loadData();render();toast(`${r.processed||0} follow-up draft(s) created`)}
async function addInterview(){let candidates=data.apps.filter(x=>['Applied','Recruiter Contacted','Follow-up Due','Interview','Assessment'].includes(x.status));if(!candidates.length){toast('Create/apply to an application first');return}let a=candidates[0];if(candidates.length>1){let choices=candidates.map((x,i)=>{let j=data.jobs.find(y=>y.id===x.job_id)||{};return `${i+1}. ${j.title||'Role'} — ${j.company_name||'Company'} [${x.status}]`}).join('\n');let pick=prompt('Which application is this interview for?\n\n'+choices,'1');if(pick===null)return;let idx=Number(pick)-1;if(!Number.isInteger(idx)||!candidates[idx]){toast('Invalid application selection');return}a=candidates[idx]}let stage=prompt('Interview stage?','HR');if(!stage)return;let date=prompt('Date/time? (optional ISO or local)','');if(date===null)return;let interviewer=prompt('Interviewer name? (optional)','');if(interviewer===null)return;let type=prompt('Interview type?','Video');if(type===null)return;let meeting=prompt('Meeting URL? (optional)','');if(meeting===null)return;let {data:r,error}=await client.rpc('jh_create_interview',{p_application_id:a.id,p_stage:stage,p_scheduled_at:date||null,p_interviewer:interviewer||null,p_interview_type:type||null,p_meeting_url:meeting||null});if(error){toast('Interview save failed: '+error.message);return}await loadData();render();toast('Interview saved and application linked → Interview')}
async function generateInterviewPrep(interviewId){let i=data.interviews.find(x=>x.id===interviewId);if(!i)return;let a=data.apps.find(x=>x.id===i.application_id)||{};let j=data.jobs.find(x=>x.id===a.job_id)||{};let p=getProfile();let jd=(j.description||'')+' '+(j.title||'')+' '+(j.education_requirements||'')+' '+(j.certification_requirements||'')+' '+JSON.stringify(j.required_skills||[])+' '+JSON.stringify(j.preferred_skills||[])+' '+JSON.stringify(j.tools||[]);let text=jd.toLowerCase();let profile=((p?.resume_summary||'')+' '+(p?.current_job_title||'')+' '+(p?.target_role||'' )+' '+(data.resumes.find(r=>r.id===a.resume_id)?.raw_text||'')).toLowerCase();let signals=['excel','financial analysis','financial modeling','fp&a','budgeting','forecasting','variance analysis','power bi','sql','accounting','finance','reporting','dashboard','mis','business analysis','customer service','communication','operations','data analysis'];let hits=signals.filter(x=>text.includes(x));let gaps=hits.filter(x=>!profile.includes(x));let questions=[`Walk me through your background and why you want this ${j.title||'role'}.`,`Why are you interested in ${j.company_name||'this company'}?`,`Tell me about a time you handled a difficult customer or process issue.`,`What have you done to improve accuracy, productivity, or process quality?`,`Why are you moving toward your target career direction?`,`What would you focus on in your first 30 days in this role?`];let technical=hits.slice(0,6).map(x=>`How have you used ${x} or how would you use it in this role?`);if(!technical.length)technical=['What are the key skills you believe are required for this role?','How would you approach learning an unfamiliar process or tool?'];let checklist=['Read the live JD line-by-line and mark every must-have.','Prepare 3 truthful STAR stories from real work/college experience.','Prepare a 60-second introduction tied to this role.','Review every skill listed below and be ready to explain your actual level.'];let summary=`${i.stage||'Interview'} prep for ${j.title||'the role'} at ${j.company_name||'the company'}. This is a baseline prep pack using the stored JD/profile data; verify company-specific facts with current research before the interview.`;let notes=`${summary}\n\nLIKELY QUESTIONS\n${questions.map((q,n)=>`${n+1}. ${q}`).join('\n')}\n\nTECHNICAL / DOMAIN\n${technical.map((q,n)=>`${n+1}. ${q}`).join('\n')}\n\nYOUR GAPS\n${gaps.map(x=>'• '+x).join('\n')||'• None detected from stored profile/resume text'}\n\nPREP CHECKLIST\n${checklist.map(x=>'• '+x).join('\n')}`;let ok=await update('jh_interviews',interviewId,{prep_notes:notes,questions:questions.concat(technical),answers:[]});if(ok){await loadData();render();let panel=document.getElementById('prepPanel');if(panel)panel.innerHTML=`<h2>Interview Prep — ${esc(j.title||'Role')}</h2><div class="small muted">${esc(summary)}</div><pre style="white-space:pre-wrap;font:inherit;line-height:1.55;margin:14px 0 0">${esc(notes)}</pre>`;toast('Prep pack saved')}}
function openCompanyResearch(jobId){go('research');setTimeout(()=>searchCompany(jobId),50)}
async function saveProfile(){let p=getProfile();let obj={full_name:pn.value,current_job_title:cr.value,education:ed.value,current_salary:+cs.value,target_direction:td.value};let r;if(p.id)r=await update('jh_profiles',p.id,obj);else r=await insert('jh_profiles',obj);if(r){if(!p.id)data.profiles.push(r);else Object.assign(p,obj);render();toast('Profile saved to Supabase')}}
async function recommendResume(id){
  const {data:r,error}=await client.rpc('jh_recommend_resume',{p_job_id:id});
  if(error){toast('Resume recommendation failed');alert(error.message);return}
  const msg=r.resume_id?`Recommended resume: ${r.resume_name}\nCategory: ${r.resume_category||'general'}\nAlignment: ${Number(r.alignment_score||0).toFixed(0)}/100\nRecommendation: ${r.recommendation}\n\n${r.rationale}`:`${r.recommendation}\n\n${r.rationale}`;
  alert(msg);
}

async function analyzeJob(id){
  let j=data.jobs.find(x=>x.id===id); if(!j)return;
  toast('Running job intelligence…');
  let activeResume=data.resumes.find(x=>x.is_active)||data.resumes[0]||null;
  let {data:r,error}=await client.functions.invoke('job-ai-intelligence',{body:{job_id:id,resume_id:activeResume?.id||null}});
  if(error){toast('AI analysis failed: '+error.message);return}
  if(!r?.ok){toast('AI analysis failed: '+(r?.error||'Unknown error'));return}
  const a=r.analysis||r;
  j.ai_analysis=a;
  const legacy={job_id:id,resume_id:a.resume_id||activeResume?.id||null,match_score:Number(a.match_score||0),career_value_score:Number(a.career_trajectory_score||0),opportunity_score:Number(a.opportunity_score||0),classification:a.recommendation||'Review',strengths:a.matched_skills||[],gaps:a.gaps||[],transferable_skills:[],recommendation:a.recommendation||'Review',rationale:a.rationale||''};
  j.score_record=legacy;
  const i=data.scores.findIndex(x=>x.job_id===id); if(i>=0)data.scores[i]=legacy; else data.scores.push(legacy);
  render();
  const mode=a.analysis_mode||r.mode||'unknown';
  const details=[
    'MODE: '+mode,
    'Opportunity: '+Number(a.opportunity_score||0).toFixed(0)+'/100',
    'Job Fit: '+Number(a.match_score||0).toFixed(0)+'/100',
    'Career Trajectory: '+Number(a.career_trajectory_score||0).toFixed(0)+'/100',
    'Recommendation: '+(a.recommendation||'Review'),
    'Confidence: '+(a.confidence||'Unknown'),
    '',
    'Required skills: '+((a.required_skills||[]).join(', ')||'None detected'),
    'Matched skills: '+((a.matched_skills||[]).join(', ')||'None detected'),
    'Transferable skills: '+((a.transferable_skills||[]).join(', ')||'None detected'),
    'Gaps: '+((a.gaps||[]).join(', ')||'None detected'),
    'Missing qualifications: '+((a.missing_qualifications||[]).join(', ')||'None detected'),
    '',
    'Rationale: '+(a.rationale||''),
    a.web_research?.length?'Web research leads: '+a.web_research.length+' (verify before relying on them)':''
  ].filter(x=>x!==undefined&&x!==null).join('\n');
  alert(val(j,['title'],'Role')+' — '+val(j,['company_name'],'Company')+'\n\n'+details);
}
function openChat(){chat.classList.toggle('open');if(chat.classList.contains('open'))chatInput.focus()}
function askZaffar(){let i=chatInput,q=i.value.trim();if(!q)return;let b=chatBody;b.innerHTML+=`<div class="bubble user">${esc(q)}</div>`;let l=q.toLowerCase(),r='';if(l.includes('job')||l.includes('apply')){let top=data.jobs.slice().sort((a,b)=>jobScore(b).opp-jobScore(a).opp)[0];r=top?`Priority: <b>${esc(val(top,['title','role'],'role'))}</b> at ${esc(val(top,['company_name','company'],'company'))}, opportunity ${jobScore(top).opp}/100. Verify the live JD before applying.`:'No jobs are stored yet.'}else if(l.includes('skill')||l.includes('excel')||l.includes('sql'))r='Keep one active priority. Strengthen Excel + financial-analysis evidence first; queue SQL until the current priority is sufficiently evidenced.';else if(l.includes('pipeline')||l.includes('application'))r=`You have <b>${data.apps.length}</b> tracked applications and <b>${data.interviews.length}</b> interviews. I will optimize for quality and career trajectory, not application count.`;else r='Ask me which job to prioritize, whether to apply, what skill to focus on, or what is blocking your pipeline.';b.innerHTML+=`<div class="bubble">${r}</div>`;b.scrollTop=b.scrollHeight;i.value=''}
boot();
</script></body></html>
